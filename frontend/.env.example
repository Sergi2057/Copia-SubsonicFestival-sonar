# Copia este archivo como .env (Vite solo lee las variables que empiezan por VITE_)
# Dirección del API Gateway (docker-compose global de la rama infra)
VITE_API_URL=http://localhost:8000/api/v1
# true = en el modal de login aparece "Entrar como…" con los usuarios de prueba (tokens dev:, sin Firebase).
# Solo funciona si el gateway tiene MODO_AUTENTICACION=desarrollo. Nunca en producción.
VITE_MODO_DESARROLLO=true
