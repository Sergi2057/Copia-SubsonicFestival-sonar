# Copia este archivo como .env para ejecutar el gateway fuera de Docker (python main.py).
PUERTO=8000
# Dónde está cada microservicio (los de tu equipo, arrancados con su docker-compose o el global de infra)
ESCALETA_URL=http://localhost:8001
ESPACIOS_URL=http://localhost:8002
USUARIOS_URL=http://localhost:8003
TIENDA_URL=http://localhost:8004
ANALITICA_URL=http://localhost:8005
# firebase = solo tokens reales de Firebase. desarrollo = además dev:<uid>:<ROL>[:<email>] (nunca en producción)
MODO_AUTENTICACION=desarrollo
FIREBASE_PROJECT_ID=subsonicfestivall3g1
# Orígenes del front-end (Vite usa el 5173), separados por comas
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173
