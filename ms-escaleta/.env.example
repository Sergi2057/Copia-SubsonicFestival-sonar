# Copia este archivo como .env para ejecutar el servicio fuera de Docker (python main.py).
# La base de datos y Redis son los del docker-compose (puertos 5435 y 6380 en tu equipo).
DATABASE_URL=postgresql+psycopg://escaleta:escaleta@localhost:5435/escaleta_db
REDIS_URL=redis://localhost:6380/0
PUERTO=8001
# Clave de la API de YouTube Data v3 (la del .env del monolito). Vacío = sin vídeos
YOUTUBE_API_KEY=
# RabbitMQ de infra (cd ../infra && docker compose up -d). Vacío = los eventos solo van al log
RABBITMQ_URL=amqp://subsonic:subsonic@localhost:5672/%2F
