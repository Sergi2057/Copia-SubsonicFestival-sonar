# Variables para docker-compose.global.yml. Copia este archivo como .env (el .env NO se sube a git).

# Clave de la API de YouTube Data v3 para los vídeos de los artistas (ms-escaleta). Vacía: los artistas salen sin vídeos.
YOUTUBE_API_KEY=

# Login real con Firebase: deja firebase-claves.json en infra/secretos/ y descomenta la línea (ver secretos/LEEME.md).
# Sin ella, ms-usuarios usa Firebase simulado y se entra con los usuarios de prueba.
# FIREBASE_CREDENCIALES=/secretos/firebase-claves.json
