# Copia este archivo como .env para ejecutar el servicio fuera de Docker (python main.py).
# MongoDB y Redis son los del docker-compose (puertos 27018 y 6381 en tu equipo).
MONGO_URL=mongodb://localhost:27018
MONGO_DB=analitica_db
REDIS_URL=redis://localhost:6381/0
PUERTO=8005
# RabbitMQ de infra (cd ../infra && docker compose up -d). Vacío = el consumidor no arranca
RABBITMQ_URL=amqp://subsonic:subsonic@localhost:5672/%2F
