# Copia este archivo como .env para ejecutar el servicio fuera de Docker (python main.py).
# La base de datos es la del docker-compose (puerto 5433 en tu equipo).
DATABASE_URL=postgresql+psycopg://usuarios:usuarios@localhost:5433/usuarios_db
PUERTO=8003
ESPACIOS_URL=http://localhost:8002
ESCALETA_URL=http://localhost:8001
TOKEN_SERVICIO=token-servicio-dev
QR_SECRETO=secreto-qr-dev
# Ruta al JSON de la cuenta de servicio de Firebase (vacío = Firebase simulado)
FIREBASE_CREDENCIALES=
# En local: amqp://subsonic:subsonic@localhost:5672/%2F (vacío = solo log).
# Docker usa rabbitmq:5672 por defecto; no pongas localhost al arrancar el contenedor.
RABBITMQ_URL=
